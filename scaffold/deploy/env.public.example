# Public — скопировать на VPS (например /etc/TODO_SLUG/env). Не коммитить секреты.
# Канон: docs/deployment.md · docs/checklists/public-vps.md

APP_NAME=TODO_PROJECT_NAME
APP_ENV=production

# Auth / session
AUTH_REQUIRED=1
JWT_SECRET=replace-with-random-string-at-least-32-chars
# TOKEN_SECRET=replace-with-random-string-at-least-32-chars

PUBLIC_URL=https://TODO_DOMAIN
CORS_ORIGINS=https://TODO_DOMAIN
TRUST_PROXY=1
ALLOW_REGISTER=1

# API process
HOST=0.0.0.0
PORT=8000
# Public: start with 1 worker; shared rate-limit/gates if workers>1
UVICORN_WORKERS=1
NO_RELOAD=1

# Meta DB (facts/files often stay on disk volume — product choice)
PG_PASSWORD=replace-with-random-postgres-password
# DATABASE_URL=postgresql://TODO_DB_USER:PASSWORD@db:5432/TODO_DB_NAME

# Data dir inside container / on host
# DATA_DIR=/app/.data

# Optional SMTP (confirm / reset)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS=1
# ALERT_EMAIL_FROM=noreply@TODO_DOMAIN
